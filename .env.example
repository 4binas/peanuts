# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
PUBLIC_OIDC_PROVIDER_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=

# Web push notifications (optional; push is off while the keys are empty)
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: address or https URL. Defaults to ORIGIN.
VAPID_SUBJECT=
